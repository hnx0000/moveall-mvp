{
  "expo": {
    "name": "GROOV",
    "slug": "moveall",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "moveall",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.moveall"
    },
    "android": {
      "package": "com.example.moveall",
      "adaptiveIcon": {
        "backgroundColor": "#ECFDF5"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GROOV가 운동 경로와 거리를 기록하려면 현재 위치 접근이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GROOV가 운동 인증샷을 선택하려면 사진 보관함 접근이 필요합니다.",
          "cameraPermission": "GROOV가 운동 인증샷을 촬영하려면 카메라 접근이 필요합니다.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
