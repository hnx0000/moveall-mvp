EXPO_PUBLIC_API_URL=http://localhost:3000
# Expo 개발 빌드에서만 로그인 화면을 자동 통과합니다. 끄려면 false로 설정하세요.
EXPO_PUBLIC_DEV_AUTH_BYPASS=true
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Optional for MVP; replace the public demo with a production routing service before launch.
EXPO_PUBLIC_ROUTE_API_URL=https://valhalla1.openstreetmap.de/route
