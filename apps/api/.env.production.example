NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATA_STORE=postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:PRODUCTION_DB_PASSWORD@REGION.pooler.supabase.com:5432/postgres
DATABASE_MAX_CONNECTIONS=5
DATABASE_SSL=require
DATABASE_SSL_CA_FILE=certs/supabase-prod-ca-2021.crt
AUTH_SECRET=generate-a-unique-production-secret-at-least-32-characters
