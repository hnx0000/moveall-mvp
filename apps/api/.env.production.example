APPLE_CLIENT_IDS=com.longrun0000.groov
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
ADMIN_EMAILS=operations@example.com
DEV_AUTH_BYPASS=false
MEDIA_STORAGE=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_IN_DEPLOYMENT_SECRET_MANAGER_ONLY
EXPO_PUSH_ACCESS_TOKEN=SET_IN_DEPLOYMENT_SECRET_MANAGER_ONLY
SUPABASE_MEDIA_BUCKET=groov-media
CORS_ORIGINS=https://groov.longrun0000.chatgpt.site
# 운영 작업 전용. 실제 값은 GitHub/호스팅 Secret에만 저장합니다.
