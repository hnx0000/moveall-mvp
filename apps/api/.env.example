NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATA_STORE=memory
DATABASE_URL=postgresql://moveall:change-me@localhost:5432/moveall
AUTH_SECRET=replace-with-at-least-32-random-characters
# Google Cloud Console에서 만든 Web/iOS/Android OAuth 클라이언트 ID를 쉼표로 구분합니다.
GOOGLE_CLIENT_IDS=
# 개발 중 로그인 화면 자동 통과. production에서는 true로 설정할 수 없습니다.
DEV_AUTH_BYPASS=true
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
