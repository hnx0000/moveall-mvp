NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATA_STORE=postgres
# Supabase Connect 화면의 Session pooler(장기 실행 서버) 또는 Transaction pooler(서버리스) URI
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@REGION.pooler.supabase.com:5432/postgres
DATABASE_MAX_CONNECTIONS=5
DATABASE_SSL=require
DATABASE_SSL_CA_FILE=certs/supabase-prod-ca-2021.crt
AUTH_SECRET=replace-with-at-least-32-random-characters
# Google Cloud Console에서 만든 Web/iOS/Android OAuth 클라이언트 ID를 쉼표로 구분합니다.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
ADMIN_EMAILS=
# 개발 중 로그인 화면 자동 통과. production에서는 true로 설정할 수 없습니다.
DEV_AUTH_BYPASS=true
MEDIA_STORAGE=disabled
SUPABASE_URL=https://PROJECT_REF.supabase.co
# 반드시 서버 Secret에만 저장하고 앱의 EXPO_PUBLIC_* 값으로 노출하지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=
# Expo 푸시 보안 토큰을 사용하도록 설정한 경우에만 서버 Secret으로 주입합니다.
EXPO_PUSH_ACCESS_TOKEN=
SUPABASE_MEDIA_BUCKET=groov-media
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
